{
  "name": "@skedia/literal-sql",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./bin/cli.ts"
  },
  "fmt": {
    "include": ["**/*.ts"],
    "exclude": [],
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "exclude": [
    ".git",
    ".opencode"
  ],
  "tasks": {
    "test": "deno test tests/ --allow-read --allow-write --allow-run",
    "test:sql": "deno test tests/sql.test.ts",
    "check": "deno check **/*.ts",
    "cli": "deno run --allow-read bin/cli.ts"
  }
}
